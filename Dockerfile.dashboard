FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt requirements-dashboard.txt ./
ENV PIP_DEFAULT_TIMEOUT=120 PIP_RETRIES=10
RUN pip install --no-cache-dir -r requirements.txt -r requirements-dashboard.txt
COPY app /app/app
COPY config /app/config
ENV PYTHONPATH=/app/app PYTHONUNBUFFERED=1 MT_HOME=/app
ENV STREAMLIT_THEME_PRIMARY_COLOR=#16a34a
RUN useradd -u 1000 -m mt
USER mt
EXPOSE 8501
ENTRYPOINT ["streamlit", "run", "/app/app/dashboard.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true", "--browser.gatherUsageStats=false"]
